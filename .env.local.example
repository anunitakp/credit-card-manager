# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings → API).
#
# Never commit .env.local — it's already in .gitignore.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# The "service_role" secret key (NOT the "anon" public key).
# This is used only in server-side API routes and is never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
